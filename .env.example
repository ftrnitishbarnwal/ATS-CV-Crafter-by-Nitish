# ---------------------------------------------------------------
# TailorCV configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0
# Set to true when running behind a reverse proxy / load balancer so rate limits use the client IP.
TRUST_PROXY=false

# AI provider: auto | anthropic | local
#   auto      -> uses Anthropic when ANTHROPIC_API_KEY is set, otherwise the built-in rules engine
#   local     -> never calls an external AI service
AI_PROVIDER=auto

# Anthropic (Claude) API key — server-side only, never sent to the browser.
ANTHROPIC_API_KEY=
# Model used for resume rewriting and extraction.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: override API base URL (e.g. an approved gateway).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Abort AI calls after this many milliseconds and fall back to the rules engine.
AI_TIMEOUT_MS=60000

# Per-IP request limits (per minute, per server instance)
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=8
